# Copy to .env at the repo root and fill in the values. Never commit .env.
# Plain KEY=value lines, no quotes (read as a .properties file by Spring and as an env_file by Docker Compose).
# google-genai (default) or anthropic
AI_PROVIDER=google-genai
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Admin account, created at startup; needed to log in until sign-up exists. Set both or neither; one alone or an invalid value stops startup.
# Username: 3-30 ASCII letters, digits, _ or -. Password: 8-72 characters, only ASCII letters, digits and -_.@%+=!* (no spaces, $, \, # or quotes).
# A changed ADMIN_PASSWORD updates the admin's password. A different ADMIN_USERNAME adds a second admin,
# unless a user already has that name (case ignored): an admin's password is updated, a normal user only gets a warning.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# docker compose only, defaults shown
# ALCHEMIST_PORT=2500
# ALCHEMIST_DATA_DIR=./data
# Uncomment to run the live AI test in mvnw verify (real API calls; needs GEMINI_API_KEY).
# LIVE_TESTS=true
