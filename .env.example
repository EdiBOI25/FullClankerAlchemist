# Copy to .env at the repo root and fill in the values. Never commit .env.
# Plain KEY=value lines, no quotes (read as a .properties file).
# google-genai (default) or anthropic
AI_PROVIDER=google-genai
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# docker compose only, defaults shown
# ALCHEMIST_PORT=2500
# ALCHEMIST_DATA_DIR=./data
# Uncomment to run the live AI test in mvnw verify (real API calls; needs GEMINI_API_KEY).
# LIVE_TESTS=true
